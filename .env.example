# Copy this file to .env and replace each placeholder.
PTV_DEV_ID=your_developer_id
PTV_API_KEY=your_api_key
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook

# Optional Discord role pings (exact PTV route name to Discord role ID).
DISCORD_LINE_ROLES={"Belgrave":"123456789012345678","Lilydale":"123456789012345678"}
DISCORD_TRAM_ROLE_ID=234567890123456789
DISCORD_VLINE_ROLE_ID=345678901234567890
